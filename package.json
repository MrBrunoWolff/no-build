{
  "name": "no-build",
  "version": "1.0.0",
  "private": true,
  "description": "Example of a no-build web project using JS/TS",
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/no-build/issues"
  },
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/no-build.git"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --hot src/server.ts",
    "check": "tsc --noEmit",
    "audit": "bun audit --audit-level=high",
    "check:ci": "node scripts/quality.mjs",
    "check:code": "node scripts/quality.mjs code",
    "check:security": "node scripts/quality.mjs security"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
