{
  "name": "no-build",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Example of a no-build web project using JS/TS",
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --hot src/server.ts",
    "check": "tsc --noEmit",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/bun": "^1.3.14"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
